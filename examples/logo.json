{
  "$schema": "../schema/clearqr.schema.json",
  "version": 1,
  "type": "link",
  "content": {
    "url": "https://example.com/with-logo"
  },
  "style": {
    "preset": "sky",
    "errorCorrection": "H"
  },
  "image": {
    "mode": "logo",
    "src": "./assets/sample-logo.png",
    "scale": 0.22
  },
  "output": {
    "format": "png",
    "file": "logo.png"
  }
}
